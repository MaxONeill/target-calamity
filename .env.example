# Copy to .env and adjust for your environment. .env is gitignored.

# --- Database ---------------------------------------------------------------
# Matches the credentials baked into docker-compose.yml for local development.
# The docker service publishes Postgres 17 (pgvector + ltree + PostGIS) on 5432.
DATABASE_URL=postgres://calamity:calamity_dev_pw@localhost:5432/calamity

# Individual parts are also read by docker-compose.yml. Keep them in sync with
# DATABASE_URL above.
POSTGRES_USER=calamity
POSTGRES_PASSWORD=calamity_dev_pw
POSTGRES_DB=calamity

# --- API server -------------------------------------------------------------
# Port the Fastify server binds to. vite.config.ts proxies /api here in dev.
API_PORT=3001

# --- Clock (ADR-34) ---------------------------------------------------------
# How far net polarity may shift the tipping-point baseline, in years, in either
# direction. This is an OPERATOR ESTIMATE, not a corpus figure — it bounds how
# much aggregate sentiment is allowed to move a countdown that is otherwise
# anchored to published dated thresholds. Read by the CLIENT at BUILD time (the
# VITE_ prefix is required for Vite to expose it), so changing it needs a rebuild.
# Anything non-numeric falls back to DEFAULT_CLOCK_HORIZON (5) in clockModel.ts.
VITE_CLOCK_MAX_SHIFT_YEARS=5

# --- Anonymous submissions (ADR-45) -----------------------------------------
# SET ME. Salt for the one-way hashing of submitter identity:
#   ip_hash     = sha256(SUBMISSION_SALT + client_ip)
#   device_hash = sha256(SUBMISSION_SALT + client_deviceId)
# NO RAW IP IS EVER STORED. The salt is what makes that true: IPv4 is only ~4.3e9
# values, so an UNSALTED sha256(ip) is a reversible encoding of the address for
# anyone holding a database dump. Use a long random secret, e.g.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# REQUIRED whenever DATABASE_URL is set — the server REFUSES TO START without it
# rather than writing unsalted digests. In seed mode (no DATABASE_URL) an
# ephemeral per-process salt is generated and logged, and limits/bans reset on
# restart. Rotating this value invalidates every existing hash: all shadow bans
# and all rate-limit windows reset.
SUBMISSION_SALT=

# Set to 1 ONLY when the API sits behind a reverse proxy you control. Then the
# first hop of X-Forwarded-For is taken as the client IP. Left off (the default),
# the raw socket address is used.
#   Trusting the header when NOT proxied  → anyone forges a fresh identity per
#                                           request and the daily limit is void.
#   Ignoring it when you ARE proxied      → every client collapses onto the
#                                           proxy's address and one submission
#                                           locks out everyone.
# There is no safe guess, hence the explicit flag. Default fails toward
# over-limiting, not toward trivial evasion.
TRUST_PROXY=0

# --- Ingestion providers (ADR-44) -------------------------------------------
# Live ingestion runs on TWO providers and needs BOTH keys:
#
#   FIREWORKS_API_KEY  → Fireworks AI. Powers the LLM turns (extraction,
#                        reputability scoring, entity resolution) AND the Phase B
#                        embeddings. Fireworks speaks the OpenAI-compatible wire
#                        protocol; no request is ever made to api.openai.com.
#   FIRECRAWL_API_KEY  → Firecrawl. Powers retrieval: `/v2/search` runs the web
#                        search and scrapes each hit to markdown in one call.
#
# WITHOUT BOTH KEYS THE WORKER NO-OPS. It logs clearly and runs no cycle; the
# deterministic offline stubs exist only for tests / offline development and are
# labelled as such. Production NEVER fabricates findings from a missing key.
FIREWORKS_API_KEY=
FIRECRAWL_API_KEY=

# --- LLM (Fireworks) --------------------------------------------------------
# Model for the extraction / reputability / resolution turns. DeepSeek V4 Flash
# is the cost-effective default and supports JSON-schema constrained decoding.
INGEST_MODEL=accounts/fireworks/models/deepseek-v4-flash

# --- Embeddings (Fireworks) -------------------------------------------------
# Phase B vectorization (ADR-12: 512-dim Matryoshka-truncated embeddings stored
# as halfvec(512)). nomic-embed-text-v1.5 is Matryoshka-trained (native 768) and
# supports truncation to 512 via the `dimensions` parameter, so the DB column is
# unchanged. A REPLACEMENT MODEL MUST ALSO SUPPORT 512 DIMS — otherwise change
# EMBEDDING_DIMENSIONS *and* migrate the halfvec column, or dedupe breaks.
# With no FIREWORKS_API_KEY, Phase B falls back to non-semantic STUB vectors and
# collision detection is unreliable (and it refuses to do so in production).
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIMENSIONS=512

# --- Retrieval caps (Firecrawl cost control) --------------------------------
# Scraped results per topic, and characters of markdown kept per source. Both are
# direct cost levers: results drive Firecrawl credits, content length drives LLM
# input tokens.
FIRECRAWL_MAX_RESULTS=5
FIRECRAWL_MAX_CONTENT_CHARS=10000

# --- Live research engine (ADR-31/-32/-33, migrated by ADR-44) ---------------
# The scheduled worker (`npm run ingest`) retrieves via Firecrawl, extracts typed
# candidate factors with the Fireworks model, verifies each source's reputability,
# assigns a signed direction (effect) + magnitude (significance), and persists.
#
# Cadence in hours between ingest cycles (setInterval scheduler). Default: 6.
INGEST_INTERVAL_HOURS=6
# Optional. Comma- or newline-separated research topics. Blank = a built-in set
# spanning BOTH Calamity and Humanity so the aggregate is not structurally biased.
INGEST_TOPICS=
# Optional bounds per cycle (bounded batch, ADR-32).
INGEST_BATCH_TOPICS=3
INGEST_MAX_CANDIDATES=6
