{
  "name": "target-calamity",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Target: Calamity — an empirical, non-linear reality tracker rendered on a 3D WebGL globe.",
  "scripts": {
    "dev": "vite",
    "server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "start": "tsx server/db/migrate.ts && tsx server/index.ts",
    "build": "tsc --noEmit && eslint . && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d",
    "db:migrate": "tsx --env-file-if-exists=.env server/db/migrate.ts",
    "ingest": "tsx --env-file-if-exists=.env server/ingestion/worker.ts",
    "ingest:once": "tsx --env-file-if-exists=.env server/ingestion/worker.ts --once",
    "backfill:domains": "tsx --env-file-if-exists=.env server/ingestion/backfillDomains.ts",
    "backfill:closers": "tsx --env-file-if-exists=.env server/ingestion/backfillWindowClosers.ts",
    "ingest:projections": "tsx --env-file-if-exists=.env server/ingestion/fetchProjections.ts",
    "backfill:quantities": "tsx --env-file-if-exists=.env server/ingestion/backfillQuantityThresholds.ts",
    "resolve:efforts": "tsx --env-file-if-exists=.env server/ingestion/resolveEfforts.ts",
    "research:efforts": "tsx --env-file-if-exists=.env server/ingestion/researchCounterEfforts.ts",
    "replay:efforts": "tsx --env-file-if-exists=.env server/ingestion/replayEffortGate.ts",
    "resolve:quantities": "tsx --env-file-if-exists=.env server/ingestion/resolveQuantities.ts",
    "report:coverage": "tsx --env-file-if-exists=.env server/ingestion/coverageReport.ts",
    "backfill:significance": "tsx --env-file-if-exists=.env server/ingestion/backfillSignificance.ts",
    "backfill:recovery": "tsx --env-file-if-exists=.env server/ingestion/backfillRecovery.ts",
    "backfill:contingency": "tsx --env-file-if-exists=.env server/ingestion/backfillContingency.ts",
    "fetch:elevation": "node scripts/fetch-elevation.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "tsc --noEmit && eslint . && prettier --check . && vitest run",
    "research:outcomes": "tsx --env-file-if-exists=.env server/ingestion/researchOutcomes.ts",
    "backfill:locations": "tsx --env-file-if-exists=.env server/ingestion/backfillLocations.ts",
    "submissions:drain": "tsx --env-file-if-exists=.env server/submissions/drainQueue.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@mozilla/readability": "^0.6.0",
    "fastify": "^5.10.0",
    "kysely": "^0.27.4",
    "linkedom": "^0.18.13",
    "node-html-markdown": "^2.0.0",
    "openai": "^6.48.0",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0",
    "topojson-client": "^3.1.0",
    "tsx": "^4.19.2",
    "world-atlas": "^2.0.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.171.0",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.5",
    "vitest": "^2.1.8"
  }
}
